@model List<ZamZamClient.Models.Product>?
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Products Catalog - Apparel Accessories & Trims";
    var currentCat = ViewBag.CurrentCategory as string ?? "all";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var apiBaseUrl = Configuration["ApiBaseUrl"] ?? ViewBag.ApiBaseUrl ?? "https://localhost:7148";
}

<!-- Page Header -->
<section class="page-header-banner">
    <div class="container text-center">
        <span class="badge-pill-soft mb-3"><i class="bi bi-grid-fill text-indigo"></i>Catalog Varieties</span>
        <h1 class="display-5 fw-bold font-heading mb-2">Apparel Accessories & Trims Catalog</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-0">
            Browse our comprehensive range of woven labels, buttons, hang tags, zippers, elastics, ribbons, threads, and packaging trims manufactured to global export standards.
        </p>
    </div>
</section>

<section class="section-padding bg-light"
         id="productsSection"
         data-api-base-url="@apiBaseUrl"
         data-initial-category="@currentCat"
         data-initial-search="@currentSearch">
    <div class="container">
        <!-- Search and Filter Bar -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="row g-3 align-items-center">
                <div class="col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text"
                               id="productSearchInput"
                               class="form-control bg-light border-start-0 py-2"
                               placeholder="Search products by title, type, material (e.g. Woven Label, Button, Zipper, Elastic)..."
                               value="@currentSearch" />
                    </div>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <span class="text-muted small">
                        Showing <strong id="visibleProductsCount" class="text-indigo">0</strong> of <span id="totalProductsCount">0</span> products
                    </span>
                </div>
            </div>

            <hr class="my-3 text-muted opacity-25" />

            <!-- Category Pills (Dynamically populated from API) -->
            <div class="catalog-filter-bar mb-0" id="productFilterBar">
                <button type="button" class="filter-btn product-filter-btn active" data-category-id="0">
                    All Products
                </button>
            </div>
        </div>

        <!-- No Results Alert -->
        <div id="noProductsAlert" class="alert alert-warning text-center p-5 rounded-4 shadow-sm border-0" style="display: none;">
            <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
            <h4 class="fw-bold">No Products Match Your Criteria</h4>
            <p class="text-muted mb-0">Try clearing your search term or switching to another category.</p>
        </div>

        <!-- Products Grid (Dynamically populated from API) -->
        <div class="row g-4" id="productsGrid">
            <!-- Populated via ~/js/home/products.js -->
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home/products.js" asp-append-version="true"></script>
}
