@model List<ZamZamClient.Models.Machinery>?
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Our Machineries - World-Class Production Infrastructure";
    var apiBaseUrl = Configuration["ApiBaseUrl"] ?? ViewBag.ApiBaseUrl ?? "https://localhost:7148";
}

<style>
    .machinery-item-col {
        opacity: 1 !important;
        transform: none !important;
        visibility: visible !important;
        transition: transform 0.25s ease;
    }
    .machinery-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e0e7ff;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 4px 20px -2px rgba(79, 70, 229, 0.04);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .machinery-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 32px -4px rgba(79, 70, 229, 0.12);
        border-color: #c7d2fe;
    }
    .machinery-img-wrapper {
        position: relative;
        width: 100%;
        height: 220px;
        background-color: #f1f5f9;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 16px;
    }
    .machinery-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }
    .machinery-card:hover .machinery-img {
        transform: scale(1.06);
    }
    .machinery-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 50px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        z-index: 2;
    }
</style>

<!-- Page Header -->
<section class="page-header-banner">
    <div class="container text-center">
        <span class="badge-pill-soft mb-3"><i class="bi bi-cpu text-indigo"></i> Advanced Industrial Equipment</span>
        <h1 class="display-5 fw-bold font-heading mb-2">Our Production Machineries</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-0">
            Equipped with world-class Heidelberg offset presses, rotary label lines, ultrasonic cutters, automatic screen printers, and high-tonnage die cutting machines.
        </p>
    </div>
</section>

<section class="section-padding bg-light" id="machineriesSection" data-api-base-url="@apiBaseUrl">
    <div class="container">
        <!-- Category Filter Pills (Populated dynamically from API) -->
        <div class="catalog-filter-bar mb-5" id="machineryFilterBar">
            <button type="button" class="filter-btn machinery-filter-btn active" data-category-id="0">
                All Machineries
            </button>
        </div>

        <!-- Machineries Grid (Populated dynamically from API) -->
        <div class="row g-4" id="machineryGrid">
            <!-- Loading placeholder initially -->
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 2.5rem; height: 2.5rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h6 class="fw-semibold text-secondary">Loading machinery lineup...</h6>
            </div>
        </div>
    </div>
</section>

<!-- Machine Capabilities Highlight Banner -->
<section class="container my-5">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="section-tagline"><i class="bi bi-patch-check"></i> HIGH PRECISION TOLERANCES</span>
                <h3 class="fw-bold font-heading mb-2">German & Specialized High-Speed Lines</h3>
                <p class="text-secondary mb-0">
                    Our Heidelberg GTO and MO offset setups provide microscopic dot reproduction for premium export hang tags. Coupled with ultrasonic cold-cutting and rotary label presses, we guarantee fray-free edges, skin-safe softness, and colorfast wash durability across high-volume production schedules.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-modern-dark btn-lg">
                    Schedule a Factory Tour <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home/machineries.js" asp-append-version="true"></script>
}
