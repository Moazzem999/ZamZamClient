@model ZamZamClient.Models.QuoteRequestViewModel
@{
    ViewData["Title"] = "Request a Fast Quotation - Factory Direct Pricing";
}

<!-- Page Header -->
<section class="page-header-banner">
    <div class="container text-center">
        <span class="badge-pill-soft mb-3"><i class="bi bi-stopwatch text-indigo"></i> Fast Turnaround • Free Swatch Analysis</span>
        <h1 class="display-5 fw-bold font-heading mb-2">Request an Official Quotation</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-0">
            Submit your apparel accessories, trims, or labeling specifications. Our merchandising and costing engineers will compute factory-direct rates within 2 to 4 business hours.
        </p>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="row g-5">
            <!-- Left Info & Trust Badges -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold font-heading mb-3"><i class="bi bi-patch-check-fill text-indigo me-2"></i>Why Quote With Us?</h5>
                    
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="service-icon-box mb-0" style="width: 44px; height: 44px; font-size: 1.2rem;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Rapid Estimation</h6>
                            <p class="small text-muted mb-0">Cost calculations within 2-4 hours from tech-pack submission.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="service-icon-box mb-0" style="width: 44px; height: 44px; font-size: 1.2rem;">
                            <i class="bi bi-tag"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Direct Factory Pricing</h6>
                            <p class="small text-muted mb-0">Zero intermediary margins with transparent raw material yields.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="service-icon-box mb-0" style="width: 44px; height: 44px; font-size: 1.2rem;">
                            <i class="bi bi-palette"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Free Sampling & Swatches</h6>
                            <p class="small text-muted mb-0">Physical strike-offs provided for buyer approval before bulk run.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="service-icon-box mb-0" style="width: 44px; height: 44px; font-size: 1.2rem;">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Direct Factory Delivery</h6>
                            <p class="small text-muted mb-0">Direct dispatch van network across Gazipur, Savar, Narayanganj & Chittagong.</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Support Box -->
                <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #0a192f 0%, #172a45 100%);">
                    <h5 class="fw-bold font-heading mb-2">Need Immediate Guidance?</h5>
                    <p class="small text-slate-300 mb-3">Speak directly with our Chief Estimation Merchandiser:</p>
                    <a href="tel:+8801874633431" class="btn btn-modern-primary w-100 mb-2">
                        <i class="bi bi-telephone-fill me-2"></i> +88 01874633431
                    </a>
                    <a href="mailto:info@zztbl.com" class="btn btn-outline-light w-100">
                        <i class="bi bi-envelope me-2"></i> info@zztbl.com
                    </a>
                </div>
            </div>

            <!-- Right: Full Quotation Form -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <span class="section-tagline"><i class="bi bi-calculator-fill"></i> ESTIMATION REQUEST FORM</span>
                    <h3 class="fw-bold font-heading mb-2">Quotation Details</h3>
                    <p class="text-secondary small mb-4">
                        Please provide your order parameters. The more specifics provided (dimensions, materials, Pantone references), the faster we can process your proposal.
                    </p>

                    <form asp-controller="Home" asp-action="SubmitQuote" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label small fw-bold">Contact Person Name <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. Tareq Rahman" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label small fw-bold">Company / Garments / Buying House</label>
                                <input asp-for="CompanyName" class="form-control rounded-3" placeholder="e.g. Apex Apparel Ltd" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label small fw-bold">Work Email Address <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="merchandiser@company.com" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label small fw-bold">Phone / WhatsApp Number <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control rounded-3" placeholder="+88 018XXXXXXXX" required />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ServiceType" class="form-label small fw-bold">Product Category / Service <span class="text-danger">*</span></label>
                                <select asp-for="ServiceType" class="form-select rounded-3" required>
                                    <option value="Trims & Accessories">Trims & Accessories Manufacturing</option>
                                    <option value="Woven & Care Labels">Woven & Care Labels (Damask / Satin)</option>
                                    <option value="Buttons (Resin, Metal, Horn, Laser)">Buttons (Resin, Metal, Horn, Laser)</option>
                                    <option value="Hang Tags & Packaging">Hang Tags & Packaging Boxes</option>
                                    <option value="Zippers & Pullers">Zippers & Custom Pullers</option>
                                    <option value="Sewing & Cotton Thread">Sewing & Cotton Thread</option>
                                    <option value="Elastics & Tapes">Elastics & Tapes</option>
                                    <option value="Digital Printing">Digital Printing</option>
                                    <option value="Paper Embossing">Paper Embossing</option>
                                    <option value="Heat Press & Lamination">Heat Press & Lamination</option>
                                    <option value="Direct Selling (Ready Stock)">Direct Selling (Ready Stock)</option>
                                    <option value="Global Sourcing">Global Sourcing</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProductName" class="form-label small fw-bold">Specific Item Name</label>
                                <input asp-for="ProductName" class="form-control rounded-3" placeholder="e.g. High-Density Damask Label / Horn Button 24L" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label small fw-bold">Target Quantity (Units / Gross / Yards)</label>
                                <input asp-for="Quantity" class="form-control rounded-3" placeholder="e.g. 10,000 pcs or 500 gross" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Target Delivery Date / Lead Time</label>
                                <input type="text" class="form-control rounded-3" placeholder="e.g. Within 7 to 10 days" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Message" class="form-label small fw-bold">Detailed Specifications & Artwork Notes</label>
                                <textarea asp-for="Message" rows="4" class="form-control rounded-3" placeholder="Specify dimensions (width x height mm), background yarn colors, folds (end fold, center fold), card GSM, wash tests, or any export compliance certificates required..."></textarea>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-modern-primary btn-lg w-100">
                                    <i class="bi bi-send-check-fill me-2"></i> Submit Official Quotation Request
                                </button>
                                <span class="d-block text-center small text-muted mt-2">
                                    <i class="bi bi-shield-check text-indigo me-1"></i> We respect NDAs and garment buyer confidentiality.
                                </span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/request-quote.js" asp-append-version="true"></script>
}
