@{
    ViewData["Title"] = "About Us - Company History, Mission & Leadership";
    var team = ViewBag.Team as List<ZamZamClient.Models.TeamMember> ?? new();
    var processSteps = ViewBag.ProcessSteps as List<ZamZamClient.Models.ProcessStep> ?? new();
}

<!-- Page Header Banner -->
<section class="page-header-banner">
    <div class="container text-center">
        <span class="badge-pill-soft mb-3"><i class="bi bi-patch-check-fill text-indigo"></i> Since 2019 in Bangladesh</span>
        <h1 class="display-5 fw-bold font-heading mb-2">About ZamZam Trims (BD) Limited</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-0">
            An apparel accessories and trims products manufacturer, importer, and supplier company dedicated to international quality and sustainable progress.
        </p>
    </div>
</section>

<!-- Detailed Company Story -->
<section class="section-padding bg-white">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-tagline"><i class="bi bi-clock-history"></i> OUR STORY & HERITAGE</span>
                <h2 class="section-title">Built on Trust, Precision Engineering & Sustainable Growth</h2>
                <p class="text-secondary">
                    Since 2019, <strong>ZamZam Trims (BD) Limited</strong> has emerged as one of the most reliable, innovative, and quality-driven apparel accessories and trims manufacturer, importer, and supplier companies in Bangladesh.
                </p>
                <p class="text-secondary">
                    We established our enterprise with highly experienced and skilled industry veterans who have been engaged in the textile and RMG trade for decades. Working hand-in-hand with our clients, we meticulously understand their design specifications, cost targets, and export schedules.
                </p>
                <p class="text-secondary">
                    Our production started with a firm determination to manufacture international standard quality accessories and trims products. World-class machinery for trims and label manufacturing accelerates our strength, enabling us to consistently provide you with the finest finished products.
                </p>

                <div class="p-3 bg-light rounded-4 border my-4">
                    <h6 class="fw-bold font-heading text-dark mb-2"><i class="bi bi-collection text-indigo me-2"></i> Comprehensive Product Capabilities:</h6>
                    <p class="small text-muted mb-0">
                        Our versatile product lines encompass Woven Belt, Twill Tape, Drawstrings, Elastic, Leather Patches, Woven & Care Labels, Hang-tags, Sewing & Cotton Threads, Gum Tape, Zippers, and Custom Buttons.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-4">
                    <div>
                        <h3 class="fw-bold text-indigo mb-0">250+</h3>
                        <span class="small text-muted">Dedicated Workforce</span>
                    </div>
                    <div class="vr"></div>
                    <div>
                        <h3 class="fw-bold text-indigo mb-0">100+</h3>
                        <span class="small text-muted">Trims Product Lines</span>
                    </div>
                    <div class="vr"></div>
                    <div>
                        <h3 class="fw-bold text-indigo mb-0">100%</h3>
                        <span class="small text-muted">Export Compliant</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6">
                        <img src="~/images/slider/slide-2.jpg" alt="Label Production" class="img-fluid rounded-4 shadow-sm w-100" style="height: 250px; object-fit: cover;" onerror="this.src='/images/machineries/screenprint.jpg';" />
                    </div>
                    <div class="col-6">
                        <img src="~/images/slider/slide-3.jpg" alt="Button Manufacturing" class="img-fluid rounded-4 shadow-sm w-100" style="height: 250px; object-fit: cover;" onerror="this.src='/images/machineries/autoscreen.jpg';" />
                    </div>
                    <div class="col-12">
                        <img src="~/images/about-s3-pic.jpg" alt="Factory Floor" class="img-fluid rounded-4 shadow w-100" style="height: 240px; object-fit: cover;" onerror="this.src='/images/machineries/gto.jpg';" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pillars / Core Values -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tagline"><i class="bi bi-gem"></i> THE CORNERSTONES OF OUR SUCCESS</span>
            <h2 class="section-title">Why Bangladesh's Leading Garment Exporters Trust Us</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                    <div class="service-icon-box mb-3">
                        <i class="bi bi-eye"></i>
                    </div>
                    <h4 class="fw-bold font-heading mb-2">Dynamic Vision & Foresight</h4>
                    <p class="text-secondary small mb-0">
                        Anticipating fashion industry trends, eco-friendly consumer preferences, and sustainable yarn requirements to keep our clients ahead in global markets.
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                    <div class="service-icon-box mb-3">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <h4 class="fw-bold font-heading mb-2">Advanced Mechanization</h4>
                    <p class="text-secondary small mb-0">
                        State-of-the-art German Heidelberg offset presses, computerized rotary label weaving, and ultrasonic micro-cutting eliminate human error and ensure repeatable batch uniformity.
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                    <div class="service-icon-box mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-bold font-heading mb-2">Rigorous Quality Assurance</h4>
                    <p class="text-secondary small mb-0">
                        Multi-point testing for color fastness, tensile elongation, wash resistance, seam stability, and non-toxic chemical compliance under OEKO-TEX guidelines.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Detailed 3-Step Work Process -->
<section class="section-padding bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tagline"><i class="bi bi-bezier2"></i> PRODUCTION WORKFLOW</span>
            <h2 class="section-title">The Complete Work Process & Customer Policy</h2>
            <p class="section-description mx-auto">
                Every customer order follows our standardized 3-phase lifecycle, ensuring zero guesswork, full visibility, and strict deadline compliance.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var step in processSteps)
            {
                <div class="col-lg-4 reveal delay-@(step.StepNumber)">
                    <div class="card card-sheen h-100 border rounded-4 p-4 shadow-sm position-relative overflow-hidden">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge bg-indigo rounded-pill px-3 py-2 fw-bold">PHASE 0@(step.StepNumber)</span>
                            <span class="fs-1 fw-bold text-muted opacity-25 font-heading">0@(step.StepNumber)</span>
                        </div>
                        <h4 class="fw-bold font-heading text-dark mb-2">@step.Subtitle</h4>
                        <p class="text-secondary small mb-4">@step.Description</p>
                        
                        <div class="mb-4">
                            <img src="@step.ImageUrl" alt="@step.Title" class="img-fluid rounded-3 w-100" style="height: 180px; object-fit: cover;" onerror="this.src='/images/Planning.jpg';" />
                        </div>

                        <ul class="list-unstyled mb-0">
                            @foreach (var cp in step.Checkpoints)
                            {
                                <li class="d-flex align-items-start gap-2 mb-2 small text-secondary">
                                    <i class="bi bi-check-circle-fill text-indigo mt-1"></i>
                                    <span>@cp</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Executive Leadership Team -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-tagline"><i class="bi bi-people-fill"></i> OUR MANAGEMENT</span>
            <h2 class="section-title">Key Leaders Responsible for Operations</h2>
            <p class="section-description mx-auto">
                Experienced visionaries driving precision, quality assurance, and sustainable business relationships.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            @for (int i = 0; i < team.Count; i++)
            {
                var member = team[i];
                <div class="col-lg-4 col-md-6 reveal delay-@(i + 1)">
                    <div class="team-card card-sheen h-100">
                        <div class="team-img-wrapper">
                            <img src="@member.ImageUrl" alt="@member.Name" class="team-img" onerror="this.src='/images/team/Mahadi.jpg';" />
                        </div>
                        <div class="team-body">
                            <h4 class="team-name">@member.Name</h4>
                            <div class="team-role">@member.Role</div>
                            <p class="team-bio mb-0">@member.Bio</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
