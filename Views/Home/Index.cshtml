@model ZamZamClient.Models.HomeViewModel
@{
    ViewData["Title"] = "Your Trusted Partner in Garments Accessories";
}

<!-- Hero Canvas (Faithfully matching Reference Image) -->
<section class="hero-canvas">
    <div class="container">
        <div class="hero-giant-card text-center position-relative">
            <!-- Floating Glass Badges with Organic Floating Physics -->
            <div class="position-absolute d-none d-md-flex align-items-center hero-floating-stat float-1" style="top: 15%; left: 6%;">
                <div class="stat-dot-blue"></div>
                <div class="text-start">
                    <div class="stat-val-text"><span class="counter-val" data-target="250">0</span>+</div>
                    <div class="stat-label-text">Skilled Workforce</div>
                </div>
            </div>

            <div class="position-absolute d-none d-md-flex align-items-center hero-floating-stat float-2" style="bottom: 35%; left: 10%;">
                <i class="bi bi-globe-americas text-primary fs-5"></i>
                <div class="text-start ms-2">
                    <div class="stat-val-text"><span class="counter-val" data-target="100">0</span>+</div>
                    <div class="stat-label-text">Product Varieties</div>
                </div>
            </div>

            <div class="position-absolute d-none d-md-flex align-items-center hero-floating-stat float-3" style="top: 18%; right: 7%;">
                <i class="bi bi-star-fill text-warning fs-5"></i>
                <div class="text-start ms-2">
                    <div class="stat-val-text"><span class="counter-val" data-target="4.9">0.0</span>/5</div>
                    <div class="stat-label-text">Quality Rating</div>
                </div>
            </div>

            <div class="position-absolute d-none d-md-flex align-items-center hero-floating-stat float-4" style="bottom: 35%; right: 10%;">
                <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                <div class="text-start ms-2">
                    <div class="stat-val-text"><span class="counter-val" data-target="98">0</span>%</div>
                    <div class="stat-label-text">On-Time Delivery</div>
                </div>
            </div>

            <!-- Central Hero Headline -->
            <h1 class="hero-main-title">
                Your trusted partner in <span class="gradient-text-indigo">garments accessories</span>
            </h1>
            <p class="hero-lead-text">
                Delivering quality, creativity, and reliability in every trim. We operate modern mechanized production floors providing world-class labels, tags, buttons, zippers, and digital printing.
            </p>

            <!-- Pill CTA Buttons -->
            <div class="d-flex justify-content-center flex-wrap gap-3 mb-4">
                <a asp-controller="Home" asp-action="Products" class="btn btn-modern-primary px-4 py-2">
                    Explore Products
                </a>
                <button type="button" class="btn btn-modern-outline px-4 py-2" onclick="openQuoteModal('', '')">
                    Request Quotes
                </button>
            </div>

            <!-- 3 Bottom Image Showcase within Hero Card -->
            <div class="row g-3 hero-images-row justify-content-center">
                <div class="col-md-4 col-sm-6">
                    <div class="hero-thumb-box">
                        <img src="~/images/slider/slide-1.jpg" alt="Machinery Production Line" class="hero-thumb-img" onerror="this.src='/images/machineries/gto.jpg';" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="hero-thumb-box">
                        <img src="~/images/slider/slide-3.jpg" alt="Thread Spools & Trims" class="hero-thumb-img" onerror="this.src='/images/products/Cotton.jpg';" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-6 d-none d-md-block">
                    <div class="hero-thumb-box">
                        <img src="~/images/slider/slide-2.jpg" alt="Label Printing Systems" class="hero-thumb-img" onerror="this.src='/images/machineries/autoscreen.jpg';" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

