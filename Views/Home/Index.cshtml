        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> H&M GROUP</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> ZARA / INDITEX</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> LACOSTE</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> PUMA SE</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> TOMMY HILFIGER</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> TARGET CORP</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> MARKS & SPENCER</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> WALMART RMG</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> GAP INC.</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> C&A EUROPE</span>
    </div>
</div>

<!-- Section 2: Most Versatile Garment Accessories Manufacturer (Matching Image Grid) -->
<section class="section-padding bg-white crosshair-corner">
    <div class="container">
        <div class="row align-items-end mb-5 reveal">
            <div class="col-lg-6">
                <h2 class="section-title mb-0">
                    Most Versatile Garment <span class="gradient-text-indigo">Accessories Manufacturer</span>
                </h2>
            </div>
            <div class="col-lg-6 text-lg-end mt-3 mt-lg-0">
                <p class="text-secondary small mb-2">
                    At ZamZam Trims (BD) Limited, we are proud to be Bangladesh's most versatile and reliable garment accessories manufacturer. From labels and hang tags to elastics, patches, and packaging, we elevate your products with precision.
                </p>
                <a asp-controller="Home" asp-action="About" class="text-primary fw-bold text-decoration-none small">
                    Read our stories <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- 5-Card Grid matching the reference layout -->
        <div class="row g-4">
            <!-- Row 1: 3 Cards -->
            <div class="col-lg-4 col-md-6 reveal delay-1">
                <div class="value-card card-sheen p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="service-icon-box mb-0">
                            <i class="bi bi-tags-fill"></i>
                        </div>
                        <span class="badge bg-light text-primary border">Best Price</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Competitive Pricing</h5>
                    <p class="text-secondary small mb-0">
                        We offer cost-effective solutions without compromising on quality. Our production and sourcing strategies ensure you get premium accessories at direct factory rates.
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 reveal delay-2">
                <div class="value-card card-sheen p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="service-icon-box mb-0">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <span class="badge bg-light text-primary border">OEKO-TEX</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Unmatched Quality</h5>
                    <p class="text-secondary small mb-0">
                        Every product we deliver reflects our commitment to excellence. With strict in-line QC, we guarantee accessories that enhance your garments with durability and beauty.
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 reveal delay-3">
                <div class="value-card card-sheen p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="service-icon-box mb-0">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <span class="badge bg-light text-primary border">Guaranteed</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Highly Reliable</h5>
                    <p class="text-secondary small mb-0">
                        Consistency is our promise. From on-time delivery to flawless execution, we ensure your brand can rely on us for every order, large or small.
                    </p>
                </div>
            </div>

            <!-- Row 2: 2 Wider Cards (Trusted brands & Customer repetition) -->
            <div class="col-lg-6 reveal delay-1">
                <div class="value-card card-sheen p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="service-icon-box mb-0">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <span class="badge bg-light text-primary border">Export Grade</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Trusted by Leading Garments & Brands</h5>
                    <p class="text-secondary small mb-3">
                        Global and local fashion leaders trust us as their accessories partner. Our long-standing collaborations are built on quality, reliability, and innovation across RMG sectors.
                    </p>
                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <span class="badge bg-light text-dark border px-3 py-2">Woven Belts</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Twill Tape</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Drawstring</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Hang Tags</span>
                        <span class="badge bg-light text-dark border px-3 py-2">Buttons</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 reveal delay-2">
                <div class="value-card card-sheen p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="service-icon-box mb-0">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <span class="badge bg-light text-success border">95% Repeat Rate</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Customer Repetition & Retention</h5>
                    <p class="text-secondary small mb-3">
                        Our clients return to us because we consistently exceed expectations. By combining value, service, and excellence, we build lasting partnerships that drive success.
                    </p>
                    <!-- Visual Mini Graph Bar with Scroll Animation -->
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Client Satisfaction & Order Growth</span>
                            <strong class="text-primary">+38% YoY</strong>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-primary dynamic-progress-bar" role="progressbar" style="width: 0%; transition: width 1.6s cubic-bezier(0.16, 1, 0.3, 1);" data-target="95%" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Business We Help To Grow -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="row align-items-center mb-4 reveal">
            <div class="col-lg-6">
                <h2 class="section-title mb-1">
                    Business We <span class="gradient-text-indigo">Help To Grow</span>
                </h2>
                <p class="text-secondary small mb-0">
                    From emerging labels to established garment conglomerates, we empower businesses of all sizes with international accessories.
                </p>
            </div>
            <div class="col-lg-6 text-lg-end mt-3 mt-lg-0">
                <div class="catalog-filter-bar mb-0 justify-content-lg-end">
                    <button type="button" class="filter-btn business-profile-tab active" data-tab="enterprise">Enterprise</button>
                    <button type="button" class="filter-btn business-profile-tab" data-tab="startup">Startup</button>
                    <button type="button" class="filter-btn business-profile-tab" data-tab="merchandiser">Merchandiser</button>
                    <button type="button" class="filter-btn business-profile-tab" data-tab="garments">Garments</button>
                    <button type="button" class="filter-btn business-profile-tab" data-tab="trader">Trader</button>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white reveal delay-1">
            <div class="row align-items-center g-4 dynamic-tab-content" id="businessProfileContent">
                <div class="col-lg-5">
                    <span class="badge bg-light text-primary border mb-2 px-3 py-2 profile-tag">Dedicated Support</span>
                    <h3 class="fw-bold text-dark mb-3 profile-title">Enterprise Garment Manufacturers</h3>
                    <p class="text-secondary small mb-4 profile-desc">
                        We provide a complete range of accessories tailored to your production needs. Our commitment is to streamline operations, reduce delays, and deliver superior-quality apparel trims so manufacturers can focus on creating world-class garments.
                    </p>
                    <ul class="list-unstyled small text-secondary mb-4 profile-bullets">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-indigo me-2"></i> High-volume monthly output capacity exceeding 10M trims/month</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-indigo me-2"></i> Dedicated merchandising account managers & direct ERP link</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-indigo me-2"></i> Punctual delivery across industrial export clusters</li>
                    </ul>
                    <button type="button" class="btn btn-modern-primary" onclick="openQuoteModal('', 'Enterprise Order')">
                        Get Started Now
                    </button>
                </div>
                <div class="col-lg-7">
                    <div class="row g-2">
                        <div class="col-6">
                            <img src="~/images/slider/slide-1.jpg" alt="Production floor" class="img-fluid rounded-3 w-100 shadow-sm profile-img-1" style="height: 280px; object-fit: cover;" onerror="this.src='/images/machineries/gto.jpg';" />
                        </div>
                        <div class="col-6">
                            <img src="~/images/slider/slide-2.jpg" alt="Garments sorting" class="img-fluid rounded-3 w-100 shadow-sm profile-img-2" style="height: 280px; object-fit: cover;" onerror="this.src='/images/machineries/autoscreen.jpg';" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 4: Effortless Process, Continuous Supply (Dark Card matching image) -->
<section class="section-padding bg-white">
    <div class="container">
        <div class="dark-process-card reveal">
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <span class="badge bg-white text-dark mb-3 px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">Trusted by 150+ active clients</span>
                    <h2 class="display-6 fw-bold mb-3">Effortless process, continuous supply</h2>
                    <p class="text-slate-400 small mb-4">
                        Our structured production and supply workflow ensures smooth order placement, timely validation, and continuous deliveries without bottlenecks.
                    </p>
                    <button type="button" class="btn btn-light rounded-pill px-4 text-dark fw-bold" onclick="openQuoteModal('', '')">
                        Get Started <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>

                <div class="col-lg-7">
                    <!-- Neon Illuminated Connecting Track -->
                    <div class="process-neon-track">
                        <div class="process-neon-bar" id="processNeonBar"></div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="process-step-column h-100">
                                <span class="process-step-tag">Step 01</span>
                                <div class="process-pct-badge"><span class="counter-pct" data-target="10">0</span>%</div>
                                <h6 class="text-white small fw-bold mb-0">Send Quotes</h6>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="process-step-column h-100">
                                <span class="process-step-tag">Step 02</span>
                                <div class="process-pct-badge"><span class="counter-pct" data-target="20">0</span>%</div>
                                <h6 class="text-white small fw-bold mb-0">Requirement</h6>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="process-step-column h-100">
                                <span class="process-step-tag">Step 03</span>
                                <div class="process-pct-badge"><span class="counter-pct" data-target="40">0</span>%</div>
                                <h6 class="text-white small fw-bold mb-0">Order Place</h6>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="process-step-column h-100">
                                <span class="process-step-tag">Step 04</span>
                                <div class="process-pct-badge text-warning"><span class="counter-pct" data-target="100">0</span>%</div>
                                <h6 class="text-white small fw-bold mb-0">Delivery</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

