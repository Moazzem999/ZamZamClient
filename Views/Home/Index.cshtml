        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> GAP INC.</span>
        <span class="marquee-brand-pill"><i class="bi bi-patch-check-fill text-indigo"></i> C&A EUROPE</span>
        <!-- Duplicated for continuous infinite marquee -->
