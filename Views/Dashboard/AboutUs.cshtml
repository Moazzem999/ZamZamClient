@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "About Us - Manage Site";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148";
}

<!-- Page Root Container -->
<div class="about-us-page-wrapper" id="aboutUsPageContainer" data-api-base-url="@apiBaseUrl">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="dash-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span>Manage Site</span>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span class="current">About Us</span>
    </nav>

    <!-- Page Heading Area -->
    <div class="dashboard-heading-area d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="dashboard-title">About Us Overview</h1>
            <p class="dashboard-subtitle">Manage company heritage, story, production facilities, and capabilities.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Create About Us Button -->
            <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" id="btnOpenCreateModal" title="Create new About Us section">
                <i class="bi bi-plus-lg"></i>
                <span class="fw-semibold">Create About Us</span>
            </button>

            <!-- Refresh Button -->
            <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" id="btnRefreshAboutUs" title="Reload from API">
                <i class="bi bi-arrow-clockwise refresh-icon"></i>
                <span class="fw-semibold">Refresh</span>
            </button>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="dash-table-card">

        <!-- Card Header Toolbar -->
        <div class="dash-card-header">
            <div class="dash-card-header-left">
                <div class="dash-header-icon">
                    <i class="bi bi-info-circle-fill"></i>
                </div>
                <div>
                    <h2 class="dash-card-title">All About Us Records</h2>
                    <p class="dash-card-subtitle">Complete registry of narrative, experience, and capability content</p>
                </div>
            </div>

            <!-- Search Controls Toolbar -->
            <div class="dash-toolbar-controls">
                <!-- Live Search Box -->
                <div class="dash-search-group" style="min-width: 290px;">
                    <i class="bi bi-search dash-search-icon"></i>
                    <input type="text" 
                           id="searchAboutUsInput" 
                           class="dash-search-input" 
                           placeholder="Search records..." 
                           autocomplete="off" />
                    <button type="button" class="dash-search-clear" id="searchClearBtn" title="Clear search" style="display: none;">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Table Responsive Container -->
        <div class="table-responsive">
            <table class="dash-custom-table" id="aboutUsTable">
                <thead>
                    <tr>
                        <th style="width: 75px;" class="text-center"># ID</th>
                        <th style="width: 170px;">Section Label</th>
                        <th style="width: 26%;">Main Heading</th>
                        <th>Introduction Preview</th>
                        <th style="width: 105px;" class="text-center">Status</th>
                        <th style="width: 130px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="aboutUsTableBody">
                    <!-- Populated dynamically via dashboard-about-us.js -->
                </tbody>
            </table>

            <!-- Loading State -->
            <div id="tableLoadingState" class="dash-table-state-box">
                <div class="dash-state-icon-circle icon-loading">
                    <div class="spinner-border text-primary" style="width: 2rem; height: 2rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <h3 class="dash-state-title">Fetching About Us Records</h3>
                <p class="dash-state-desc">Connecting to secure API server and loading About Us data...</p>
            </div>

            <!-- Error State -->
            <div id="tableErrorState" class="dash-table-state-box d-none">
                <div class="dash-state-icon-circle icon-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="dash-state-title">Unable to Load About Us Records</h3>
                <p class="dash-state-desc" id="errorMessageText">
                    Failed to fetch data from the server. Please verify your connection or API status.
                </p>
                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-3" id="btnRetryAboutUs">
                    <i class="bi bi-arrow-repeat me-1"></i> Try Again
                </button>
            </div>

            <!-- Empty State -->
            <div id="tableEmptyState" class="dash-table-state-box d-none">
                <div class="dash-state-icon-circle icon-empty">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h3 class="dash-state-title">No About Us Records Found</h3>
                <p class="dash-state-desc">There are currently no About Us section records stored in the database.</p>
                <button type="button" class="btn btn-primary btn-sm px-4 py-2 rounded-3 mt-2" onclick="$('#btnOpenCreateModal').trigger('click');">
                    <i class="bi bi-plus-lg me-1"></i> Create First About Us Record
                </button>
            </div>

            <!-- No Search Results State -->
            <div id="tableNoResultsState" class="dash-table-state-box d-none">
                <div class="dash-state-icon-circle icon-empty">
                    <i class="bi bi-search"></i>
                </div>
                <h3 class="dash-state-title">No Matching Records</h3>
                <p class="dash-state-desc">No About Us records match your search query.</p>
            </div>
        </div>

        <!-- Card Footer -->
        <div class="dash-card-footer">
            <div class="d-flex align-items-center gap-2">
                <span id="tableCountSummary">Loading records...</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="bi bi-info-circle"></i>
                <span>Click on any record row or the eye icon to inspect full story, descriptions &amp; capabilities</span>
            </div>
        </div>

    </div>

</div>

<!-- About Us Detail Modal -->
<div class="modal fade" id="aboutUsDetailModal" tabindex="-1" aria-labelledby="modalDetailHeading" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content brand-modal-content border-0">
            <!-- Modal Header -->
            <div class="modal-header brand-modal-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary p-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark m-0" id="modalDetailHeading">
                            About Us Details <span class="text-muted fw-normal fs-6" id="modalRecordId">#1</span>
                        </h5>
                        <small class="text-muted">Full presentation view of selected About Us record</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="modalStatusBadge" class="dash-status-badge status-active">
                        <span class="status-dot"></span>
                        <span>Active</span>
                    </span>
                    <button type="button" class="dash-action-btn btn-edit" id="btnEditFromDetailModal" title="Update About Us record" style="width: 32px; height: 32px;">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="button" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body brand-modal-body p-4">
                <!-- Section Label & Main Heading Banner -->
                <div class="p-3 rounded-3 bg-white border mb-3">
                    <span class="about-section-badge mb-2" id="modalSectionLabel">OUR STORY &amp; HERITAGE</span>
                    <h4 class="fw-bold text-dark mb-0" id="modalMainHeading" style="line-height: 1.35;">
                        Built on Trust, Precision Engineering &amp; Sustainable Growth
                    </h4>
                </div>

                <!-- 1. Introduction Card -->
                <div class="about-detail-card">
                    <div class="about-detail-card-title">
                        <i class="bi bi-quote"></i>
                        <span>Introduction &amp; Company Inception</span>
                    </div>
                    <p class="about-detail-card-text" id="modalIntroduction">—</p>
                </div>

                <!-- 2. Experience & Production Side-by-Side -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="about-detail-card h-100 mb-0">
                            <div class="about-detail-card-title">
                                <i class="bi bi-award-fill"></i>
                                <span>Industry Experience</span>
                            </div>
                            <p class="about-detail-card-text" id="modalExperienceDescription">—</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="about-detail-card h-100 mb-0">
                            <div class="about-detail-card-title">
                                <i class="bi bi-gear-wide-connected"></i>
                                <span>Production &amp; Machinery</span>
                            </div>
                            <p class="about-detail-card-text" id="modalProductionDescription">—</p>
                        </div>
                    </div>
                </div>

                <!-- 3. Product Capabilities Card -->
                <div class="about-detail-card mb-0">
                    <div class="about-detail-card-title">
                        <i class="bi bi-layers-fill"></i>
                        <span id="modalCapabilityTitle">Comprehensive Product Capabilities:</span>
                    </div>
                    <p class="about-detail-card-text" id="modalCapabilityDescription">—</p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end">
                <button type="button" class="btn btn-primary btn-sm rounded-3 px-4 py-2" data-bs-dismiss="modal">
                    Close Details
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Floating Toast Notification -->
<div class="dash-toast-container">
    <div class="dash-toast" id="dashToast" role="alert" aria-live="assertive" aria-atomic="true">
        <i class="bi bi-check-circle-fill dash-toast-icon"></i>
        <span id="dashToastMessage">Action completed successfully.</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard-about-us.js" asp-append-version="true"></script>
}
