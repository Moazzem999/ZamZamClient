@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quotations - Manage Site";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148";
}

<!-- Page Root Container -->
<div class="quotations-page-wrapper" id="quotationsPageContainer" data-api-base-url="@apiBaseUrl">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="dash-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span>Manage Site</span>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span class="current">Quotations</span>
    </nav>

    <!-- Page Heading Area -->
    <div class="dashboard-heading-area d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="dashboard-title">Quotations</h1>
            <p class="dashboard-subtitle">Manage, review, and track customer quotation requests.</p>
        </div>
    </div>

    <!-- Main Card Placeholder -->
    <div class="dash-table-card p-4">
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-chat-square-quote text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">Quotations Management</h4>
            <p class="text-muted mb-0">This page is ready for quotation management features.</p>
        </div>
    </div>
</div>
