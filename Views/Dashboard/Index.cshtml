@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard Overview";
}

<!-- Dashboard Heading Area -->
<div class="dashboard-heading-area">
    <h1 class="dashboard-title">Dashboard Overview</h1>
    <p class="dashboard-subtitle">Manage your business and team members here.</p>
</div>

<!-- Key Metric Overview Cards (Matching Provided Design) -->
<div class="metric-cards-grid">
    <!-- 1. Total Employees -->
    <div class="metric-card">
        <div class="metric-icon-box icon-blue">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="metric-info">
            <span class="metric-label">Total Employees</span>
            <h2 class="metric-value">6</h2>
        </div>
    </div>

    <!-- 2. New Hires (This Month) -->
    <div class="metric-card">
        <div class="metric-icon-box icon-green">
            <i class="bi bi-plus-lg"></i>
        </div>
        <div class="metric-info">
            <span class="metric-label">New Hires (This Month)</span>
            <h2 class="metric-value">12</h2>
        </div>
    </div>

    <!-- 3. Open Roles -->
    <div class="metric-card">
        <div class="metric-icon-box icon-amber">
            <i class="bi bi-building"></i>
        </div>
        <div class="metric-info">
            <span class="metric-label">Open Roles</span>
            <h2 class="metric-value">8</h2>
        </div>
    </div>
</div>
