<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Solution Dashboard</title>

    <!-- Immediate Authentication Guard: Block unauthenticated access without screen flash -->
    <script>
        (function () {
            try {
                const token = localStorage.getItem('token');
                if (!token) {
                    window.location.replace('/Account/Login');
                }
            } catch (e) {
                window.location.replace('/Account/Login');
            }
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Dedicated Dashboard Stylesheet -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

    <!-- Left Navigation Sidebar -->
    <aside class="dashboard-sidebar" id="dashboardSidebar">
        <!-- Brand Title -->
        <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
            <h4 class="brand-title">
                <span class="text-primary-blue">Business</span> <span class="text-white-heading">Solution</span>
            </h4>
        </a>

        <!-- Menu Navigation Items -->
        <ul class="sidebar-menu">
            <!-- Dashboard Item (Active) -->
            <li class="menu-item active">
                <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
                    <span class="menu-link-inner">
                        <span class="menu-icon"><i class="bi bi-grid-fill"></i></span>
                        <span>Dashboard</span>
                    </span>
                </a>
            </li>

            <!-- Employees Item -->
            <li class="menu-item">
                <a href="javascript:void(0)" class="menu-link">
                    <span class="menu-link-inner">
                        <span class="menu-icon"><i class="bi bi-people"></i></span>
                        <span>Employees</span>
                    </span>
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
            </li>

            <!-- Suppliers Item -->
            <li class="menu-item">
                <a href="javascript:void(0)" class="menu-link">
                    <span class="menu-link-inner">
                        <span class="menu-icon"><i class="bi bi-truck"></i></span>
                        <span>Suppliers</span>
                    </span>
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
            </li>

            <!-- Accounts Item -->
            <li class="menu-item">
                <a href="javascript:void(0)" class="menu-link">
                    <span class="menu-link-inner">
                        <span class="menu-icon"><i class="bi bi-folder2"></i></span>
                        <span>Accounts</span>
                    </span>
                    <i class="bi bi-chevron-down chevron-icon"></i>
                </a>
            </li>

            <!-- Settings Item -->
            <li class="menu-item">
                <a href="javascript:void(0)" class="menu-link">
                    <span class="menu-link-inner">
                        <span class="menu-icon"><i class="bi bi-gear"></i></span>
                        <span>Settings</span>
                    </span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content Area Wrapper -->
    <div class="dashboard-main-wrapper">
        <!-- Top Sticky Header Navigation -->
        <header class="dashboard-topbar">
            <div class="topbar-actions">
                <!-- Theme / Palette Icon -->
                <button type="button" class="topbar-icon-btn" title="Theme Palette" aria-label="Theme">
                    <i class="bi bi-palette"></i>
                </button>

                <!-- Notifications Bell -->
                <button type="button" class="topbar-icon-btn position-relative" title="Notifications" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <!-- User Profile Avatar & Dropdown -->
                <div class="dropdown">
                    <div class="user-avatar-circle" id="userAvatarInitials" data-bs-toggle="dropdown" aria-expanded="false" title="Account Menu">
                        MH
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow-sm" aria-labelledby="userAvatarInitials">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark" id="userDisplayName">Moazzem Hossain</div>
                            <small class="text-muted text-truncate d-block" id="userDisplayEmail">meraj2@gmail.com</small>
                        </li>
                        @* <li>
                            <a class="dropdown-item py-2 small" href="javascript:void(0)">
                                <i class="bi bi-person me-2 text-primary"></i> My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small" href="javascript:void(0)">
                                <i class="bi bi-gear me-2 text-muted"></i> Account Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li> *@
                        <li>
                            <button type="button" class="dropdown-item py-2 small text-danger" onclick="logoutDashboard()">
                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body Canvas -->
        <main class="dashboard-content">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Populate profile dynamically from stored user data
        document.addEventListener('DOMContentLoaded', function () {
            const userJson = localStorage.getItem('user');
            if (userJson) {
                try {
                    const user = JSON.parse(userJson);
                    const name = user.name || user.userName || 'Moazzem Hossain';
                    const email = user.email || 'meraj2@gmail.com';

                    const nameEl = document.getElementById('userDisplayName');
                    if (nameEl) nameEl.textContent = name;

                    const emailEl = document.getElementById('userDisplayEmail');
                    if (emailEl) emailEl.textContent = email;

                    // Initials for avatar
                    const parts = name.trim().split(/\s+/);
                    let initials = 'MH';
                    if (parts.length >= 2) {
                        initials = (parts[0][0] + parts[1][0]).toUpperCase();
                    } else if (parts.length === 1 && parts[0].length >= 2) {
                        initials = parts[0].substring(0, 2).toUpperCase();
                    }
                    const avatarEl = document.getElementById('userAvatarInitials');
                    if (avatarEl) avatarEl.textContent = initials;
                } catch (e) {
                    console.warn('Error reading stored user', e);
                }
            }
        });

        // Sign Out Handler
        function logoutDashboard() {
            try {
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                document.cookie = "token=; path=/; max-age=0";
                document.cookie = "zamzam_token=; path=/; max-age=0";
            } catch (e) {}
            window.location.href = '/Account/Logout';
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
