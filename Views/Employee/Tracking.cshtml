@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Tracking";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148";
}

<style>
    /* =========================================================
       EMPLOYEE TRACKING & SEARCH STYLES
       ========================================================= */
    .tracking-page-wrapper {
        animation: fadeIn 0.3s ease;
    }

    /* Search Container Card */
    .tracking-search-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        position: relative;
        margin-bottom: 1.75rem;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .tracking-search-card:focus-within {
        border-color: #93c5fd;
        box-shadow: 0 8px 30px rgba(37, 99, 235, 0.08);
    }

    .tracking-search-box-wrapper {
        position: relative;
        width: 100%;
    }

    .tracking-search-input-group {
        position: relative;
        display: flex;
        align-items: center;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        transition: all 0.2s ease;
    }
    .tracking-search-input-group:focus-within {
        background: #ffffff;
        border-color: var(--dash-primary-blue);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .tracking-search-icon-left {
        padding-left: 1.25rem;
        padding-right: 0.75rem;
        color: #64748b;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        pointer-events: none;
    }
    .tracking-search-input-group:focus-within .tracking-search-icon-left {
        color: var(--dash-primary-blue);
    }

    .tracking-search-input {
        border: none;
        background: transparent;
        font-size: 1.05rem;
        font-weight: 500;
        color: #0f172a;
        padding: 0.85rem 0.5rem;
        flex: 1;
        outline: none;
        width: 100%;
    }
    .tracking-search-input::placeholder {
        color: #94a3b8;
        font-weight: 400;
    }

    .tracking-search-action-area {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-right: 0.65rem;
    }

    .tracking-search-clear-btn {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 1.15rem;
        cursor: pointer;
        padding: 0.35rem;
        border-radius: 50%;
        display: none;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }
    .tracking-search-clear-btn:hover {
        color: #ef4444;
        background: #fee2e2;
    }

    .tracking-search-spinner {
        color: var(--dash-primary-blue);
        width: 1.2rem;
        height: 1.2rem;
        margin-right: 0.25rem;
    }

    .tracking-search-submit-btn {
        background: var(--dash-primary-blue);
        color: #ffffff;
        border: none;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.55rem 1.25rem;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
    }
    .tracking-search-submit-btn:hover {
        background: #1d4ed8;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }
    .tracking-search-submit-btn:active {
        transform: translateY(0);
    }

    /* Auto-suggestions Dropdown */
    .tracking-search-suggestions {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
        z-index: 1050;
        overflow: hidden;
        display: none;
    }
    .tracking-search-suggestions.show {
        display: block;
        animation: slideDownFade 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .suggestions-header {
        padding: 0.65rem 1rem;
        background: #f8fafc;
        border-bottom: 1px solid #edf2f7;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .suggestions-list {
        max-height: 320px;
        overflow-y: auto;
    }
    .suggestions-list::-webkit-scrollbar {
        width: 6px;
    }
    .suggestions-list::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .tracking-suggestion-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
    .tracking-suggestion-item:last-child {
        border-bottom: none;
    }
    .tracking-suggestion-item:hover,
    .tracking-suggestion-item.active {
        background-color: #eff6ff;
    }

    .suggestion-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        background: #e2e8f0;
        border: 2px solid #ffffff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .suggestion-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .suggestion-avatar-fallback {
        font-weight: 700;
        font-size: 0.95rem;
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
        color: #1d4ed8;
    }

    .suggestion-info {
        flex: 1;
        min-width: 0;
    }
    .suggestion-name-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2px;
    }
    .suggestion-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #0f172a;
    }
    .search-highlight {
        background: #fef08a;
        color: #854d0e;
        padding: 0 2px;
        border-radius: 3px;
    }
    .suggestion-badge {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        background: #f1f5f9;
        color: #475569;
    }

    .suggestion-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
        color: #64748b;
        flex-wrap: wrap;
    }
    .suggestion-desig {
        font-weight: 600;
        color: var(--dash-primary-blue);
    }
    .suggestion-arrow {
        color: #94a3b8;
        font-size: 1.3rem;
        transition: transform 0.2s ease, color 0.2s ease;
    }
    .tracking-suggestion-item:hover .suggestion-arrow {
        transform: translateX(3px);
        color: var(--dash-primary-blue);
    }

    .suggestions-footer {
        padding: 0.5rem 1rem;
        background: #f8fafc;
        border-top: 1px solid #edf2f7;
        font-size: 0.75rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Multi Results Switcher Bar */
    .tracking-multi-bar {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .tracking-result-chip {
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .tracking-result-chip:hover {
        background: #eff6ff;
        border-color: #93c5fd;
        color: var(--dash-primary-blue);
    }
    .tracking-result-chip.active {
        background: var(--dash-primary-blue);
        border-color: var(--dash-primary-blue);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }
    .tracking-result-chip .chip-id {
        opacity: 0.75;
        font-size: 0.72rem;
    }

    /* Hero Profile Card */
    .tracking-hero-card {
        background: linear-gradient(135deg, #090e1a 0%, #0f172a 40%, #172554 100%);
        border-radius: 20px;
        padding: 2rem;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }
    .tracking-hero-card::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 350px;
        height: 350px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.25) 0%, transparent 70%);
        pointer-events: none;
    }

    .tracking-hero-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
    }

    .tracking-hero-avatar-box {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        background: #1e293b;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .tracking-hero-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .tracking-hero-avatar-fallback {
        font-size: 2.2rem;
        font-weight: 800;
        color: #93c5fd;
        text-transform: uppercase;
    }

    .tracking-hero-info {
        flex: 1;
        min-width: 240px;
    }
    .tracking-hero-name {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.35rem;
        line-height: 1.2;
    }
    .tracking-hero-badges {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .hero-pill-badge {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .hero-badge-desig {
        background: rgba(59, 130, 246, 0.25);
        color: #bfdbfe;
        border: 1px solid rgba(147, 197, 253, 0.3);
    }
    .hero-badge-id {
        background: rgba(255, 255, 255, 0.12);
        color: #f1f5f9;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .hero-badge-status {
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
        border: 1px solid rgba(52, 211, 153, 0.3);
    }

    .status-indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 8px #10b981;
        animation: pulseDot 2s infinite;
    }

    .tracking-hero-actions {
        display: flex;
        gap: 0.6rem;
        align-items: center;
        margin-left: auto;
    }

    /* Key Stats Strip */
    .tracking-stats-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        position: relative;
        z-index: 1;
    }
    .tracking-stat-item {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 0.85rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }
    .tracking-stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(59, 130, 246, 0.2);
        color: #60a5fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .tracking-stat-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 2px;
    }
    .tracking-stat-val {
        font-size: 1rem;
        font-weight: 700;
        color: #ffffff;
    }
    .tracking-stat-val a {
        color: #ffffff !important;
    }
    .tracking-stat-val a:hover {
        color: #93c5fd !important;
    }

    /* Section Cards */
    .tracking-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.35rem 1.5rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
        margin-bottom: 1.5rem;
        height: 100%;
    }
    .tracking-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 0.85rem;
        margin-bottom: 1rem;
        border-bottom: 1px dashed #cbd5e1;
    }
    .tracking-section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .tracking-section-title i {
        color: var(--dash-primary-blue);
        font-size: 1.1rem;
    }

    .emp-prop-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem 1.25rem;
    }
    .emp-prop-item {
        margin-bottom: 0.25rem;
    }
    .emp-prop-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 2px;
        display: block;
    }
    .emp-prop-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #0f172a;
    }

    .btn-copy-small {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 0.82rem;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
        transition: all 0.15s ease;
    }
    .btn-copy-small:hover {
        color: var(--dash-primary-blue);
        background: #eff6ff;
    }

    /* Document Thumbnails */
    .tracking-doc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 1rem;
    }
    .tracking-doc-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        background: #f8fafc;
        position: relative;
        aspect-ratio: 16 / 11;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .tracking-doc-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .tracking-doc-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease;
    }
    .tracking-doc-card:hover .tracking-doc-overlay {
        opacity: 1;
    }
    .tracking-doc-empty {
        padding: 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        background: #f8fafc;
        aspect-ratio: 16 / 11;
    }

    /* Tracking & Location Activity Visual */
    .tracking-live-radar {
        background: #090e1a;
        border-radius: 14px;
        padding: 1.25rem;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        border: 1px solid #1e293b;
    }
    .tracking-radar-grid {
        position: absolute;
        inset: 0;
        background-size: 24px 24px;
        background-image: 
            linear-gradient(to right, rgba(59, 130, 246, 0.08) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(59, 130, 246, 0.08) 1px, transparent 1px);
        pointer-events: none;
    }
    .tracking-radar-pulse {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 1px solid rgba(59, 130, 246, 0.35);
        animation: radarPing 3s infinite cubic-bezier(0, 0, 0.2, 1);
        pointer-events: none;
    }

    .tracking-timeline {
        list-style: none;
        padding-left: 1.25rem;
        margin: 1rem 0 0 0;
        position: relative;
    }
    .tracking-timeline::before {
        content: '';
        position: absolute;
        left: 3px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: #e2e8f0;
    }
    .tracking-timeline-item {
        position: relative;
        padding-bottom: 0.85rem;
    }
    .tracking-timeline-item:last-child {
        padding-bottom: 0;
    }
    .tracking-timeline-dot {
        position: absolute;
        left: -1.25rem;
        top: 4px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--dash-primary-blue);
        box-shadow: 0 0 0 3px #eff6ff;
    }
    .tracking-timeline-dot.success {
        background: #10b981;
        box-shadow: 0 0 0 3px #ecfdf5;
    }

    /* Example Search Pills */
    .tracking-example-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .tracking-example-pill:hover {
        background: var(--dash-primary-blue);
        color: #ffffff;
        border-color: var(--dash-primary-blue);
        transform: translateY(-1px);
    }

    /* State Boxes */
    .tracking-state-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 3.5rem 1.5rem;
        text-align: center;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
    }
    .tracking-state-icon-box {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin: 0 auto 1.25rem auto;
    }
    .tracking-state-icon-box.initial {
        background: #eff6ff;
        color: var(--dash-primary-blue);
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.15);
    }
    .tracking-state-icon-box.no-results {
        background: #fef2f2;
        color: #ef4444;
        box-shadow: 0 8px 24px rgba(239, 68, 68, 0.15);
    }
    .tracking-state-icon-box.error {
        background: #fff7ed;
        color: #ea580c;
        box-shadow: 0 8px 24px rgba(234, 88, 12, 0.15);
    }

    /* Animations */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes slideDownFade {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.3); }
    }
    @@keyframes radarPing {
        0% { transform: translate(-50%, -50%) scale(0.2); opacity: 0.8; }
        100% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
    }
    .spin-animation {
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>

<!-- Page Root Container -->
<div class="tracking-page-wrapper" id="employeeTrackingContainer" data-api-base-url="@apiBaseUrl">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="dash-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span>Employee</span>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span class="current">Tracking</span>
    </nav>

    <!-- Page Heading Area -->
    <div class="dashboard-heading-area d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="dashboard-title">Employee Tracking</h1>
            <p class="dashboard-subtitle">Search staff personnel by name to monitor profiles, duty logs, and location credentials.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Employee" asp-action="List" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" title="View all employees directory">
                <i class="bi bi-list-ul"></i>
                <span class="fw-semibold">All Employees</span>
            </a>
            <a asp-controller="Employee" asp-action="Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" title="Add new employee record">
                <i class="bi bi-person-plus-fill"></i>
                <span class="fw-semibold">Add Employee</span>
            </a>
        </div>
    </div>

    <!-- 1. Dedicated Search Box Card -->
    <div class="tracking-search-card">
        <form id="trackingSearchForm" class="tracking-search-box-wrapper" autocomplete="off" onsubmit="return false;">
            <div class="tracking-search-input-group">
                <div class="tracking-search-icon-left">
                    <i class="bi bi-search"></i>
                </div>
                <input type="text"
                       id="trackingSearchInput"
                       class="tracking-search-input"
                       placeholder="Search employee by name (e.g. Jubayer)..."
                       aria-label="Search employee by name"
                       autocomplete="off" />

                <div class="tracking-search-action-area">
                    <!-- Loading Spinner -->
                    <div id="trackingSearchSpinner" class="spinner-border tracking-search-spinner d-none" role="status">
                        <span class="visually-hidden">Searching...</span>
                    </div>

                    <!-- Clear Button -->
                    <button type="button" id="trackingSearchClear" class="tracking-search-clear-btn" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>

                    <!-- Search Submit Button -->
                    <button type="submit" id="trackingSearchSubmitBtn" class="tracking-search-submit-btn">
                        <i class="bi bi-search"></i>
                        <span>Search</span>
                    </button>
                </div>
            </div>

            <!-- Autocomplete Live Suggestions Dropdown Overlay -->
            <div id="trackingSearchSuggestions" class="tracking-search-suggestions">
                <div class="suggestions-header">
                    <span><i class="bi bi-people me-1"></i> Matching Employees</span>
                    <span id="trackingSuggestionsCount" class="badge bg-primary text-white">0</span>
                </div>
                <div id="trackingSuggestionsList" class="suggestions-list">
                    <!-- Dynamic Suggestion Items injected by JS -->
                </div>
                <div class="suggestions-footer">
                    <span><i class="bi bi-arrow-down-up me-1"></i> Use &uarr; &darr; to navigate, Enter to select</span>
                    <span>API: /GetByName/{name}</span>
                </div>
            </div>
        </form>
    </div>

    <!-- 2. Multiple Results Switcher Bar (Shown when multiple employees match) -->
    <div id="trackingMultiResultsBar" class="tracking-multi-bar d-none">
        <div class="d-flex align-items-center gap-2 text-muted small fw-semibold">
            <i class="bi bi-filter-circle text-primary"></i>
            <span>Multiple matches found (<span id="trackingMultiResultsCount">0</span>):</span>
        </div>
        <div id="trackingMultiResultsChips" class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Dynamic Chips injected by JS -->
        </div>
    </div>

    <!-- 3. VIEW STATES -->

    <!-- State A: Initial Welcome / Prompt -->
    <div id="trackingInitialState" class="tracking-state-card">
        <div class="tracking-state-icon-box initial">
            <i class="bi bi-person-bounding-box"></i>
        </div>
        <h3 class="fs-4 fw-bold text-dark mb-2">Search an Employee to Track</h3>
        <p class="text-muted mx-auto mb-4" style="max-width: 520px;">
            Enter an employee's name in the search box above to retrieve their complete personnel profile, duty assignments, and live tracking activity.
        </p>
        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
            <span class="small text-muted me-1">Quick search:</span>
            <button type="button" class="tracking-example-pill" data-term="jub">
                <i class="bi bi-search"></i> Jubayer
            </button>
            <button type="button" class="tracking-example-pill" data-term="kamal">
                <i class="bi bi-search"></i> Kamal
            </button>
            <button type="button" class="tracking-example-pill" data-term="hossain">
                <i class="bi bi-search"></i> Hossain
            </button>
        </div>
    </div>

    <!-- State B: Loading -->
    <div id="trackingLoadingState" class="tracking-state-card d-none">
        <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="fw-bold text-dark mb-1">Searching Employee Records...</h4>
        <p class="text-muted mb-0">Querying live server database for matching staff credentials.</p>
    </div>

    <!-- State C: No Results -->
    <div id="trackingNoResultsState" class="tracking-state-card d-none">
        <div class="tracking-state-icon-box no-results">
            <i class="bi bi-person-x"></i>
        </div>
        <h3 class="fs-4 fw-bold text-dark mb-2">No Employees Found</h3>
        <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
            We couldn't find any employee record matching <strong id="trackingNoResultsTerm" class="text-dark">""</strong>.
            Please verify the spelling or try searching with a different name.
        </p>
        <button type="button" class="btn btn-outline-primary btn-sm px-3 py-2 rounded-3" id="btnResetTrackingSearch">
            <i class="bi bi-arrow-repeat me-1"></i> Clear &amp; Search Again
        </button>
    </div>

    <!-- State D: Error -->
    <div id="trackingErrorState" class="tracking-state-card d-none">
        <div class="tracking-state-icon-box error">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h3 class="fs-4 fw-bold text-dark mb-2">Failed to Retrieve Records</h3>
        <p id="trackingErrorMessage" class="text-muted mx-auto mb-4" style="max-width: 480px;">
            An error occurred while connecting to the employee search API.
        </p>
        <button type="button" class="btn btn-primary btn-sm px-3 py-2 rounded-3" id="btnRetryTrackingSearch">
            <i class="bi bi-arrow-clockwise me-1"></i> Retry Search
        </button>
    </div>

    <!-- State E: Selected Employee Detail & Tracking Card -->
    <div id="trackingEmployeeDetailCard" class="d-none">

        <!-- Hero Profile Banner -->
        <div class="tracking-hero-card">
            <div class="tracking-hero-header">
                <!-- Avatar -->
                <div class="tracking-hero-avatar-box" id="detailEmpAvatarWrapper">
                    <div class="tracking-hero-avatar-fallback">EMP</div>
                </div>

                <!-- Info -->
                <div class="tracking-hero-info">
                    <h2 class="tracking-hero-name" id="detailEmpName">Employee Name</h2>
                    <div class="tracking-hero-badges">
                        <span class="hero-pill-badge hero-badge-desig" id="detailEmpDesignation">
                            <i class="bi bi-briefcase-fill"></i> Designation
                        </span>
                        <span class="hero-pill-badge hero-badge-id" id="detailEmpId">
                            #ID
                        </span>
                        <span class="hero-pill-badge hero-badge-status" id="detailEmpStatus">
                            <span class="status-indicator-dot"></span> Active
                        </span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="tracking-hero-actions">
                    <button type="button" class="btn btn-light btn-sm rounded-3 shadow-sm d-inline-flex align-items-center gap-1" id="btnRefreshTrackingEmployee" title="Refresh details">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span class="d-none d-sm-inline">Refresh</span>
                    </button>
                    <button type="button" class="btn btn-outline-light btn-sm rounded-3 d-inline-flex align-items-center gap-1" id="btnSearchAnotherEmployee" title="Search another employee">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-sm-inline">New Search</span>
                    </button>
                </div>
            </div>

            <!-- Key Metric Highlights Strip -->
            <div class="tracking-stats-strip">
                <div class="tracking-stat-item">
                    <div class="tracking-stat-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div class="tracking-stat-label">Monthly Salary</div>
                        <div class="tracking-stat-val text-success" id="detailEmpSalary">—</div>
                    </div>
                </div>

                <div class="tracking-stat-item">
                    <div class="tracking-stat-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </div>
                    <div>
                        <div class="tracking-stat-label">Joining Date</div>
                        <div class="tracking-stat-val" id="detailEmpJoiningDate">—</div>
                    </div>
                </div>

                <div class="tracking-stat-item">
                    <div class="tracking-stat-icon">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <div class="tracking-stat-label">Mobile Number</div>
                        <div class="tracking-stat-val" id="detailEmpMobile">—</div>
                    </div>
                </div>

                <div class="tracking-stat-item">
                    <div class="tracking-stat-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <div class="tracking-stat-label">Email Address</div>
                        <div class="tracking-stat-val" id="detailEmpEmail">—</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-Column Information Grid -->
        <div class="row g-4 mb-4">
            <!-- Left Column: Personal Information & Addresses -->
            <div class="col-lg-7">
                <!-- Personal Info Card -->
                <div class="tracking-section-card mb-4">
                    <div class="tracking-section-header">
                        <h4 class="tracking-section-title">
                            <i class="bi bi-person-lines-fill"></i> Personal Information
                        </h4>
                        <span class="badge bg-light text-muted border">General</span>
                    </div>

                    <div class="emp-prop-grid">
                        <div class="emp-prop-item">
                            <span class="emp-prop-label">Father's Name</span>
                            <span class="emp-prop-value" id="detailEmpFatherName">—</span>
                        </div>
                        <div class="emp-prop-item">
                            <span class="emp-prop-label">Date of Birth</span>
                            <span class="emp-prop-value" id="detailEmpDob">—</span>
                        </div>
                        <div class="emp-prop-item">
                            <span class="emp-prop-label">National ID (NID)</span>
                            <span class="emp-prop-value" id="detailEmpNid">—</span>
                        </div>
                        <div class="emp-prop-item">
                            <span class="emp-prop-label">Academic Qualification</span>
                            <span class="emp-prop-value" id="detailEmpEducation">—</span>
                        </div>
                        <div class="emp-prop-item">
                            <span class="emp-prop-label">Religion</span>
                            <span class="emp-prop-value" id="detailEmpReligion">—</span>
                        </div>
                        <div class="emp-prop-item">
                            <span class="emp-prop-label">Marital Status</span>
                            <span class="emp-prop-value" id="detailEmpMarital">—</span>
                        </div>
                    </div>
                </div>

                <!-- Addresses Card -->
                <div class="tracking-section-card">
                    <div class="tracking-section-header">
                        <h4 class="tracking-section-title">
                            <i class="bi bi-geo-alt-fill"></i> Residential Addresses
                        </h4>
                        <span class="badge bg-light text-muted border">Location</span>
                    </div>

                    <div class="mb-3">
                        <span class="emp-prop-label"><i class="bi bi-geo-fill text-danger me-1"></i> Present Address</span>
                        <p class="emp-prop-value text-dark mb-0 ps-3 border-start border-2 border-danger" id="detailEmpPresentAddress">—</p>
                    </div>

                    <div>
                        <span class="emp-prop-label"><i class="bi bi-house-door-fill text-primary me-1"></i> Permanent Address</span>
                        <p class="emp-prop-value text-dark mb-0 ps-3 border-start border-2 border-primary" id="detailEmpPermanentAddress">—</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Documents & Tracking Overview -->
            <div class="col-lg-5">
                <!-- Identity Documents Card -->
                <div class="tracking-section-card mb-4">
                    <div class="tracking-section-header">
                        <h4 class="tracking-section-title">
                            <i class="bi bi-file-earmark-person"></i> Identity Documents
                        </h4>
                        <span class="badge bg-light text-muted border">Attachments</span>
                    </div>

                    <div class="tracking-doc-grid">
                        <div>
                            <div class="small fw-semibold text-muted mb-2">Profile Photo</div>
                            <div id="detailPhotoThumbnailBox">
                                <!-- Photo thumbnail injected by JS -->
                            </div>
                        </div>

                        <div>
                            <div class="small fw-semibold text-muted mb-2">NID Card Document</div>
                            <div id="detailNidThumbnailBox">
                                <!-- NID thumbnail injected by JS -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Real-time Tracking & Duty Log Overview -->
                <div class="tracking-section-card">
                    <div class="tracking-section-header">
                        <h4 class="tracking-section-title">
                            <i class="bi bi-radar"></i> Live Tracking Status
                        </h4>
                        <span class="badge bg-success text-white">
                            <span class="status-indicator-dot me-1"></span> Live Feed
                        </span>
                    </div>

                    <div class="tracking-live-radar mb-3">
                        <div class="tracking-radar-grid"></div>
                        <div class="tracking-radar-pulse"></div>

                        <div class="d-flex align-items-center justify-content-between position-relative z-1 mb-2">
                            <div class="fw-bold fs-6">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Mirpur Zone
                            </div>
                            <span class="badge bg-primary text-white" id="trackingCoordinates">23.8041° N, 90.3667° E</span>
                        </div>
                        <div class="small text-white-50 position-relative z-1">
                            Target: <span id="trackingTargetName" class="text-white fw-semibold">Employee</span> &bull; Status: On Duty
                        </div>
                    </div>

                    <div class="small fw-bold text-muted text-uppercase letter-spacing-1 mb-2">Recent Activity Logs</div>
                    <ul class="tracking-timeline">
                        <li class="tracking-timeline-item">
                            <span class="tracking-timeline-dot success"></span>
                            <div class="fw-semibold text-dark small">Clocked In &bull; 09:15 AM</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Headquarters - Mirpur Section 10</div>
                        </li>
                        <li class="tracking-timeline-item">
                            <span class="tracking-timeline-dot"></span>
                            <div class="fw-semibold text-dark small">Field Marketing Route Assigned &bull; 11:30 AM</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Zone Route Dhaka-1216</div>
                        </li>
                        <li class="tracking-timeline-item">
                            <span class="tracking-timeline-dot success"></span>
                            <div class="fw-semibold text-success small">Current Active Status &bull; Just Now</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Device Connected &amp; Tracking Log Ready</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- Lightbox Modal for Photo / NID Preview -->
<div class="modal fade" id="trackingImagePreviewModal" tabindex="-1" aria-labelledby="trackingModalImageTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3 px-4 border-0">
                <h5 class="modal-title fs-6 fw-bold" id="trackingModalImageTitle">Document Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light text-center">
                <img id="trackingModalImage" src="" alt="Document Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 75vh; object-fit: contain;" />
            </div>
            <div class="modal-footer bg-white py-2 px-4 border-0">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Floating Toast Container -->
<div class="dash-toast-container">
    <div class="dash-toast" id="dashToast" role="alert" aria-live="assertive" aria-atomic="true">
        <i class="bi bi-check-circle-fill dash-toast-icon"></i>
        <span id="dashToastMessage">Action completed successfully.</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/employee-tracking.js" asp-append-version="true"></script>
}
