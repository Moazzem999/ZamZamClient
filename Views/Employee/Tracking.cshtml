@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Search";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148";
}

<style>
    /* Search Box */
    .tracking-search-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
        margin-bottom: 1.5rem;
    }
    .tracking-search-box-wrapper {
        position: relative;
        width: 100%;
    }
    .tracking-search-input-group {
        position: relative;
        display: flex;
        align-items: center;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.2s ease;
    }
    .tracking-search-input-group:focus-within {
        background: #ffffff;
        border-color: var(--dash-primary-blue);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }
    .tracking-search-icon-left {
        padding-left: 1.2rem;
        padding-right: 0.65rem;
        color: #64748b;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        pointer-events: none;
    }
    .tracking-search-input-group:focus-within .tracking-search-icon-left {
        color: var(--dash-primary-blue);
    }
    .tracking-search-input {
        border: none;
        background: transparent;
        font-size: 1.05rem;
        font-weight: 500;
        color: #0f172a;
        padding: 0.85rem 0.5rem;
        flex: 1;
        outline: none;
        width: 100%;
    }
    .tracking-search-input::placeholder {
        color: #94a3b8;
    }
    .tracking-search-action-area {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-right: 0.6rem;
    }
    .tracking-search-clear-btn {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 1.15rem;
        cursor: pointer;
        padding: 0.25rem;
        display: none;
    }
    .tracking-search-clear-btn:hover {
        color: #ef4444;
    }
    .tracking-search-spinner {
        color: var(--dash-primary-blue);
        width: 1.2rem;
        height: 1.2rem;
    }
    .tracking-search-submit-btn {
        background: var(--dash-primary-blue);
        color: #ffffff;
        border: none;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.55rem 1.25rem;
        border-radius: 9px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.15s ease;
    }
    .tracking-search-submit-btn:hover {
        background: #1d4ed8;
    }

    /* Suggestions Dropdown */
    .tracking-search-suggestions {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        z-index: 1050;
        overflow: hidden;
        display: none;
    }
    .tracking-search-suggestions.show {
        display: block;
    }
    .suggestions-header {
        padding: 0.6rem 1rem;
        background: #f8fafc;
        border-bottom: 1px solid #edf2f7;
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .suggestions-list {
        max-height: 280px;
        overflow-y: auto;
    }
    .tracking-suggestion-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
    .tracking-suggestion-item:last-child {
        border-bottom: none;
    }
    .tracking-suggestion-item:hover,
    .tracking-suggestion-item.active {
        background-color: #eff6ff;
    }
    .suggestion-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .suggestion-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .suggestion-avatar-fallback {
        font-weight: 700;
        font-size: 0.88rem;
        background: #dbeafe;
        color: #1d4ed8;
    }
    .suggestion-info {
        flex: 1;
        min-width: 0;
    }

    /* Multi Results Switcher Bar */
    .tracking-multi-bar {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.65rem 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .tracking-result-chip {
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 0.3rem 0.75rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .tracking-result-chip:hover {
        background: #eff6ff;
        color: var(--dash-primary-blue);
    }
    .tracking-result-chip.active {
        background: var(--dash-primary-blue);
        border-color: var(--dash-primary-blue);
        color: #ffffff;
    }

    /* State Cards */
    .tracking-state-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 3rem 1.5rem;
        text-align: center;
    }
    .tracking-state-icon-box {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1rem auto;
    }
    .tracking-state-icon-box.initial {
        background: #eff6ff;
        color: var(--dash-primary-blue);
    }
    .tracking-state-icon-box.no-results {
        background: #fef2f2;
        color: #ef4444;
    }
    .tracking-state-icon-box.error {
        background: #fff7ed;
        color: #ea580c;
    }

    /* Detail Employee Card */
    .employee-profile-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .employee-profile-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #1e3a8a 100%);
        padding: 1.75rem 2rem;
        color: #ffffff;
    }
    .employee-profile-avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid rgba(255, 255, 255, 0.35);
        background: #1e293b;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .tracking-hero-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .tracking-hero-avatar-fallback {
        font-size: 1.8rem;
        font-weight: 700;
        color: #93c5fd;
    }
    .status-indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #10b981;
        display: inline-block;
        margin-right: 4px;
    }
    .emp-stat-pill {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        padding: 0.65rem 1rem;
    }
    .emp-stat-pill .label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #94a3b8;
        font-weight: 600;
    }
    .emp-stat-pill .val {
        font-size: 0.95rem;
        font-weight: 700;
        color: #ffffff;
    }
    .emp-stat-pill .val a {
        color: #ffffff !important;
    }

    /* Info Sections */
    .emp-info-block {
        padding: 1.75rem 2rem;
    }
    .emp-section-heading {
        font-size: 0.88rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #475569;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 1px dashed #cbd5e1;
        padding-bottom: 0.45rem;
    }
    .emp-section-heading i {
        color: var(--dash-primary-blue);
    }
    .emp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem 1.25rem;
    }
    .emp-field-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 2px;
        display: block;
    }
    .emp-field-val {
        font-size: 0.92rem;
        font-weight: 600;
        color: #0f172a;
    }
    .btn-copy-small {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 0.8rem;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
    }
    .btn-copy-small:hover {
        color: var(--dash-primary-blue);
    }

    /* Document Cards */
    .tracking-doc-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        background: #f8fafc;
        position: relative;
        aspect-ratio: 16 / 10;
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 260px;
    }
    .tracking-doc-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .tracking-doc-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease;
    }
    .tracking-doc-card:hover .tracking-doc-overlay {
        opacity: 1;
    }
    .tracking-doc-empty {
        padding: 1.5rem;
        text-align: center;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        background: #f8fafc;
        max-width: 260px;
        aspect-ratio: 16 / 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>

<!-- Page Root Container -->
<div class="employee-page-wrapper" id="employeeTrackingContainer" data-api-base-url="@apiBaseUrl">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="dash-breadcrumb">
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span>Employee</span>
        <span class="separator"><i class="bi bi-chevron-right"></i></span>
        <span class="current">Tracking</span>
    </nav>

    <!-- Page Heading Area (Clean: No All Employees / Add Employee buttons) -->
    <div class="dashboard-heading-area mb-4">
        <h1 class="dashboard-title">Employee Search</h1>
        <p class="dashboard-subtitle">Search employee by name to view employee records and details.</p>
    </div>

    <!-- 1. Dedicated Search Box -->
    <div class="tracking-search-card">
        <form id="trackingSearchForm" class="tracking-search-box-wrapper" autocomplete="off" onsubmit="return false;">
            <div class="tracking-search-input-group">
                <div class="tracking-search-icon-left">
                    <i class="bi bi-search"></i>
                </div>
                <input type="text"
                       id="trackingSearchInput"
                       class="tracking-search-input"
                       placeholder="Search employee by name (e.g. Jubayer)..."
                       aria-label="Search employee by name"
                       autocomplete="off" />

                <div class="tracking-search-action-area">
                    <!-- Spinner -->
                    <div id="trackingSearchSpinner" class="spinner-border tracking-search-spinner d-none" role="status">
                        <span class="visually-hidden">Searching...</span>
                    </div>

                    <!-- Clear Button -->
                    <button type="button" id="trackingSearchClear" class="tracking-search-clear-btn" title="Clear">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>

                    <!-- Search Button -->
                    <button type="submit" id="trackingSearchSubmitBtn" class="tracking-search-submit-btn">
                        <i class="bi bi-search"></i>
                        <span>Search</span>
                    </button>
                </div>
            </div>

            <!-- Suggestions Dropdown -->
            <div id="trackingSearchSuggestions" class="tracking-search-suggestions">
                <div class="suggestions-header">
                    <span><i class="bi bi-people me-1"></i> Matching Employees</span>
                    <span id="trackingSuggestionsCount" class="badge bg-primary text-white">0</span>
                </div>
                <div id="trackingSuggestionsList" class="suggestions-list">
                    <!-- Dynamic Items injected by JS -->
                </div>
            </div>
        </form>
    </div>

    <!-- 2. Multiple Matches Switcher Bar -->
    <div id="trackingMultiResultsBar" class="tracking-multi-bar d-none">
        <div class="text-muted small fw-semibold">
            <i class="bi bi-filter-circle text-primary me-1"></i> Matches (<span id="trackingMultiResultsCount">0</span>):
        </div>
        <div id="trackingMultiResultsChips" class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Chips injected by JS -->
        </div>
    </div>

    <!-- 3. VIEW STATES -->

    <!-- State A: Initial Empty Prompt -->
    <div id="trackingInitialState" class="tracking-state-card">
        <div class="tracking-state-icon-box initial">
            <i class="bi bi-search"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">Search Employee by Name</h4>
        <p class="text-muted mx-auto mb-0" style="max-width: 440px;">
            Type an employee's name in the search box above to load their record.
        </p>
    </div>

    <!-- State B: Loading -->
    <div id="trackingLoadingState" class="tracking-state-card d-none">
        <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h5 class="fw-bold text-dark mb-1">Searching Employee Records...</h5>
        <p class="text-muted mb-0">Querying live server database.</p>
    </div>

    <!-- State C: No Results -->
    <div id="trackingNoResultsState" class="tracking-state-card d-none">
        <div class="tracking-state-icon-box no-results">
            <i class="bi bi-person-x"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">No Employee Found</h4>
        <p class="text-muted mx-auto mb-3" style="max-width: 440px;">
            No employee record matching <strong id="trackingNoResultsTerm" class="text-dark">""</strong>.
        </p>
        <button type="button" class="btn btn-outline-primary btn-sm px-3 py-2 rounded-3" id="btnResetTrackingSearch">
            <i class="bi bi-arrow-repeat me-1"></i> Clear &amp; Search Again
        </button>
    </div>

    <!-- State D: Error -->
    <div id="trackingErrorState" class="tracking-state-card d-none">
        <div class="tracking-state-icon-box error">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">Connection Error</h4>
        <p id="trackingErrorMessage" class="text-muted mx-auto mb-3" style="max-width: 440px;">
            Unable to connect to the employee search API.
        </p>
        <button type="button" class="btn btn-primary btn-sm px-3 py-2 rounded-3" id="btnRetryTrackingSearch">
            <i class="bi bi-arrow-clockwise me-1"></i> Retry
        </button>
    </div>

    <!-- State E: Employee Profile Card -->
    <div id="trackingEmployeeDetailCard" class="d-none">
        <div class="employee-profile-card">

            <!-- Banner Header -->
            <div class="employee-profile-banner">
                <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
                    <div class="employee-profile-avatar" id="detailEmpAvatarWrapper">
                        <div class="tracking-hero-avatar-fallback">EMP</div>
                    </div>
                    <div>
                        <h2 class="fs-3 fw-bold mb-1" id="detailEmpName">Employee Name</h2>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-primary text-white" id="detailEmpDesignation">Designation</span>
                            <span class="badge bg-light text-dark" id="detailEmpId">#ID</span>
                            <span class="badge bg-success text-white" id="detailEmpStatus">
                                <span class="status-indicator-dot"></span> Active
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Stats Strip -->
                <div class="row g-2">
                    <div class="col-sm-6 col-md-3">
                        <div class="emp-stat-pill">
                            <div class="label">Monthly Salary</div>
                            <div class="val text-success" id="detailEmpSalary">—</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="emp-stat-pill">
                            <div class="label">Joining Date</div>
                            <div class="val" id="detailEmpJoiningDate">—</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="emp-stat-pill">
                            <div class="label">Mobile Number</div>
                            <div class="val" id="detailEmpMobile">—</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="emp-stat-pill">
                            <div class="label">Email Address</div>
                            <div class="val" id="detailEmpEmail">—</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Body Information Blocks -->
            <div class="emp-info-block">

                <!-- 1. Personal Details -->
                <div class="mb-4">
                    <div class="emp-section-heading">
                        <i class="bi bi-person-lines-fill"></i> Personal Information
                    </div>
                    <div class="emp-grid">
                        <div>
                            <span class="emp-field-label">Father's Name</span>
                            <span class="emp-field-val" id="detailEmpFatherName">—</span>
                        </div>
                        <div>
                            <span class="emp-field-label">Date of Birth</span>
                            <span class="emp-field-val" id="detailEmpDob">—</span>
                        </div>
                        <div>
                            <span class="emp-field-label">National ID (NID)</span>
                            <span class="emp-field-val" id="detailEmpNid">—</span>
                        </div>
                        <div>
                            <span class="emp-field-label">Academic Qualification</span>
                            <span class="emp-field-val" id="detailEmpEducation">—</span>
                        </div>
                        <div>
                            <span class="emp-field-label">Religion</span>
                            <span class="emp-field-val" id="detailEmpReligion">—</span>
                        </div>
                        <div>
                            <span class="emp-field-label">Marital Status</span>
                            <span class="emp-field-val" id="detailEmpMarital">—</span>
                        </div>
                    </div>
                </div>

                <!-- 2. Addresses -->
                <div class="mb-4">
                    <div class="emp-section-heading">
                        <i class="bi bi-geo-alt-fill"></i> Addresses
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="emp-field-label"><i class="bi bi-geo-fill text-danger me-1"></i> Present Address</span>
                            <p class="emp-field-val text-dark mb-0 ps-3 border-start border-2 border-danger" id="detailEmpPresentAddress">—</p>
                        </div>
                        <div class="col-md-6">
                            <span class="emp-field-label"><i class="bi bi-house-door-fill text-primary me-1"></i> Permanent Address</span>
                            <p class="emp-field-val text-dark mb-0 ps-3 border-start border-2 border-primary" id="detailEmpPermanentAddress">—</p>
                        </div>
                    </div>
                </div>

                <!-- 3. Photos & NID Documents -->
                <div>
                    <div class="emp-section-heading">
                        <i class="bi bi-file-earmark-person"></i> Documents
                    </div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div>
                            <span class="emp-field-label mb-1">Profile Photo</span>
                            <div id="detailPhotoThumbnailBox">
                                <!-- Photo thumbnail -->
                            </div>
                        </div>
                        <div>
                            <span class="emp-field-label mb-1">NID Document</span>
                            <div id="detailNidThumbnailBox">
                                <!-- NID thumbnail -->
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>

<!-- Lightbox Modal for Photo / NID Preview -->
<div class="modal fade" id="trackingImagePreviewModal" tabindex="-1" aria-labelledby="trackingModalImageTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3 px-4 border-0">
                <h5 class="modal-title fs-6 fw-bold" id="trackingModalImageTitle">Document Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light text-center">
                <img id="trackingModalImage" src="" alt="Document Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 75vh; object-fit: contain;" />
            </div>
            <div class="modal-footer bg-white py-2 px-4 border-0">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Floating Toast Container -->
<div class="dash-toast-container">
    <div class="dash-toast" id="dashToast" role="alert" aria-live="assertive" aria-atomic="true">
        <i class="bi bi-check-circle-fill dash-toast-icon"></i>
        <span id="dashToastMessage">Action completed successfully.</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/employee-tracking.js" asp-append-version="true"></script>
}
