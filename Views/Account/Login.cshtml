@model ZamZamClient.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In - ZamZam Client & Merchandising Portal";
}

<div class="container py-4 my-auto">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
                <!-- Login Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden auth-card">
                    <!-- Brand Top Banner / Header -->
                    <div class="auth-header text-center p-4 pb-2">
                        <div class="auth-brand-logo mb-3">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/images/logo.png" alt="ZamZam Trims (BD) Limited" class="img-fluid" style="max-height: 48px;" onerror="this.src='/images/logo-icon.png';" />
                            </a>
                        </div>
                        <h4 class="fw-bold font-heading mb-1">Welcome</h4>
                    </div>

                    <!-- Login Form Body -->
                    <div class="card-body p-4 pt-3">
                        <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" data-api-base-url="@ViewBag.ApiBaseUrl">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none" id="loginSummaryError" role="alert"></div>
                            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-none" id="loginSuccessBanner" role="alert"></div>

                            <!-- Username -->
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label small fw-bold">Username</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="Username" id="usernameInput" class="form-control bg-light border-start-0 rounded-end-3" placeholder="Enter username" autocomplete="username" required />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Password" class="form-label small fw-bold mb-0">Password</label>
                                    <a href="javascript:void(0)" class="small text-decoration-none text-indigo" onclick="alert('For password resets, please contact IT administration')">Forgot?</a>
                                </div>
                                <div class="input-group mt-1">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" id="passwordInput" class="form-control bg-light border-start-0 border-end-0" placeholder="Enter your password" autocomplete="current-password" required />
                                    <button type="button" class="btn btn-light border border-start-0 text-muted" id="togglePasswordBtn" title="Toggle password visibility">
                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            
                            <hr />

                            <!-- Submit Button -->
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-modern-primary btn-lg rounded-pill" id="loginSubmitBtn">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </button>
                            </div>

                            <!-- Back to Home Link -->
                            <div class="text-center pt-2">
                                <a asp-controller="Home" asp-action="Index" class="small text-muted text-decoration-none">
                                    <i class="bi bi-arrow-left me-1"></i> Back to Homepage
                                </a>
                            </div>
                        </form>
                    </div>

                    <!-- Footer Info in Card -->
                    <div class="card-footer bg-light border-top py-3 text-center">
                        <span class="small text-muted">
                            Need enterprise portal access?
                            <a asp-controller="Home" asp-action="Contact" class="text-indigo fw-bold text-decoration-none ms-1">Contact Support</a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
